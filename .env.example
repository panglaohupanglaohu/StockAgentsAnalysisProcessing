# Copy this file to .env. Never commit real keys.

# Server
AG_HOST=127.0.0.1
AG_PORT=8080
AG_RELOAD=1
LOG_LEVEL=INFO

# Authentication
# Keep disabled outside an isolated local development environment.
AG_ALLOW_DEFAULT_ADMIN=0
AG_PBKDF2_ITERATIONS=260000
AG_RATE_LOGIN_LIMIT=5
AG_RATE_LIMIT_WINDOW=60

# Browser origins (comma-separated)
AG_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AG_CORS_ALLOW_CREDENTIALS=1

# Models — configure only the providers used by Agent Config.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Planned TradingAgents adapter
STOCKAGENTS_TRADING_RUNTIME=disabled
STOCKAGENTS_TRADING_CHECKPOINT_DIR=storage/trading-checkpoints
STOCKAGENTS_MARKET_TIMEZONE=America/New_York
